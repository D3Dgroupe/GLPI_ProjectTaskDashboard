{% set sep = '?' in target ? '&' : '?' %}
<div class="ptd-widgets row g-3 mb-3" role="group" aria-label="Pilotage des tâches">
  {% set items = [
    { key: 'todo', label: '📌 À FAIRE', action: 'set_state', state: states.todo },
    { key: 'in_progress', label: '🔄 EN COURS', action: 'set_state', state: states.in_progress },
    { key: 'check', label: '🔎 À CONTRÔLER', action: 'set_state', state: states.check },
    { key: 'mine', label: '👤 MES TÂCHES', action: 'toggle_mine', state: null }
  ] %}
  {% for item in items %}
    {% set pressed = item.key == 'mine' ? active.mine : active.state == item.state %}
    {% set href = target ~ sep ~ 'id=' ~ project_id ~ '&forcetab=' ~ forcetab|url_encode ~ '&ptd_action=' ~ item.action %}
    {% if item.state is not null %}{% set href = href ~ '&ptd_state=' ~ item.state %}{% endif %}
    <div class="col-12 col-sm-6 col-xl-3">
      <a class="ptd-widget card text-decoration-none {{ pressed ? 'is-active' : '' }}" href="{{ href }}" aria-pressed="{{ pressed ? 'true' : 'false' }}">
        <div class="card-body py-3">
          <div class="text-muted small fw-semibold">{{ item.label }}</div>
          <div class="fs-1 fw-bold lh-1 mt-2">{{ attribute(counts, item.key) }}</div>
        </div>
      </a>
    </div>
  {% endfor %}
  <div class="col-12 text-end">
    <a class="btn btn-sm btn-outline-secondary" href="{{ target ~ sep ~ 'id=' ~ project_id ~ '&forcetab=' ~ forcetab|url_encode ~ '&reset=reset' }}">✕ Réinitialiser les filtres</a>
  </div>
</div>
