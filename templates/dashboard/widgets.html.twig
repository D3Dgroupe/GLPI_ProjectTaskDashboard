<div class="ptd-widgets mb-3" role="group" aria-label="Pilotage des tâches">
  {% set items = [
    { key: 'on_hold', label: '⏸️ EN VEILLE', action: 'set_state', state: states.on_hold },
    { key: 'todo', label: '📌 À FAIRE', action: 'set_state', state: states.todo },
    { key: 'in_progress', label: '🔄 EN COURS', action: 'set_state', state: states.in_progress },
    { key: 'check', label: '🔎 À CONTRÔLER', action: 'set_state', state: states.check },
    { key: 'blocked', label: '❓ BLOQUÉ / ATTENTE', action: 'set_state', state: states.blocked },
    { key: 'idea', label: '💡 IDÉE / BROUILLON', action: 'set_state', state: states.idea },
    { key: 'mine', label: '👤 MES TÂCHES', action: 'toggle_mine', state: null },
    { key: 'remaining', label: '📋 RESTE À FAIRE', action: 'set_remaining', state: null },
    { key: 'all', label: '🗂️ TOUTES', action: 'set_all', state: null }
  ] %}
  {% for item in items %}
    {% if item.key == 'mine' %}
      {% set pressed = active.mine %}
    {% elseif item.key == 'remaining' %}
      {% set pressed = active.remaining %}
    {% elseif item.key == 'all' %}
      {# TOUTES = no state filter at all (MES TÂCHES still composes with it). #}
      {% set pressed = active.state is null and not active.remaining %}
    {% else %}
      {% set pressed = active.state == item.state %}
    {% endif %}
    {% set reload_params = 'ptd_action=' ~ item.action %}
    {% if item.state is not null %}{% set reload_params = reload_params ~ '&ptd_state=' ~ item.state %}{% endif %}
    {# Background/text colors match the color configured on this ProjectState
       in Configuration > Dropdowns > Project statuses (same source GLPI
       itself uses to color ProjectTask cards on the Kanban). Null for the
       "mine", "remaining" and "all" widgets, which aren't tied to a single
       state. #}
    {% set colors = attribute(state_colors, item.key) %}
    <div class="ptd-widget-col">
      <a class="ptd-widget card text-decoration-none {{ pressed ? 'is-active' : '' }} {{ colors ? 'ptd-widget-colored' : '' }}"
         {% if colors %}style="--ptd-widget-bg: {{ colors.bg }}; --ptd-widget-fg: {{ colors.fg }};"{% endif %}
         href="javascript:reloadTab('{{ reload_params }}');" aria-pressed="{{ pressed ? 'true' : 'false' }}">
        {# Compact tile: label and count on a single line. #}
        <div class="card-body ptd-widget-body">
          <span class="ptd-widget-label text-muted small fw-semibold">{{ item.label }}</span>
          <span class="ptd-widget-count fw-bold">{{ attribute(counts, item.key) }}</span>
        </div>
      </a>
    </div>
  {% endfor %}
</div>
